# ──────────────────────────────────────────────
# Whitecape Knowledge Assistant — .env.example
# Copy to .env and adjust values.
# ──────────────────────────────────────────────

# ── Database ──
DATABASE_URL=postgresql+asyncpg://whitecape:whitecape@postgres:5432/whitecape

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── Qdrant ──
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
QDRANT_CACHE_COLLECTION=semantic_cache
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_HOURS=24

# ── Keycloak ──
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=whitecape
KEYCLOAK_CLIENT_ID=whitecape-app
KEYCLOAK_CLIENT_SECRET=change-me

# ── Session ──
SECRET_KEY=generate-a-strong-random-key-here
SESSION_TTL_SECONDS=86400

# ── LLM models (all via LiteLLM → Ollama, local only) ──
CLASSIFIER_MODEL=ollama/qwen2.5:7b
# CLASSIFIER_MODEL=manual                       # manual classification mode
REWRITER_MODEL=ollama/qwen2.5:14b
# REWRITER_MODEL=ollama/qwen2.5:7b              # faster, lower rewrite quality
GENERATOR_MODEL=ollama/qwen2.5:32b
# GENERATOR_MODEL=ollama/qwen2.5:14b            # faster fallback
# FAITHFULNESS_MODEL=ollama/qwen2.5:7b          # post-MVP LLM-based checking

# ── Embeddings (BGE-M3 via Ollama) ──
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=bge-m3

# ── Reranker (TEI — NOT Ollama) ──
RERANKER_URL=http://reranker:8082

# ── Ingestion ──
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=200

# ── Relevance gate ──
RELEVANCE_THRESHOLD=0.5
