        <!-- opt: re-ingestion cache invalidation -->
        <mxCell id="opt_frame" parent="1" style="shape=mxgraph.uml.frame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;fontStyle=1;width=55;height=22;" value="opt" vertex="1">
          <mxGeometry height="150" width="460" x="1030" y="860" as="geometry" />
        </mxCell>
        <mxCell id="opt_g" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=2;align=left;" value="[re-ingestion — old chunk_ids replaced]" vertex="1">
          <mxGeometry height="18" width="330" x="1095" y="865" as="geometry" />
