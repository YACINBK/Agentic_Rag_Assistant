        <!-- 202 back to admin -->
        <mxCell id="a04" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="202 Accepted (processing async)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="345" y="500" as="sourcePoint" />
            <mxPoint x="160" y="500" as="targetPoint" />
          </mxGeometry>
