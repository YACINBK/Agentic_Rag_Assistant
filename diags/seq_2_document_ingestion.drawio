        <mxCell id="x01" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="403 Forbidden — upload requires is_admin" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="345" y="300" as="sourcePoint" />
            <mxPoint x="160" y="300" as="targetPoint" />
