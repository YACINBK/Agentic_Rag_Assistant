        <mxCell id="b07" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="invalidate semantic_cache (overlapping chunk_ids)" edge="1">
          <mxGeometry relative="1" as="geometry">
