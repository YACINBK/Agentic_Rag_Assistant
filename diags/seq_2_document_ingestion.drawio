        <mxCell id="b10" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="store task result" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1085" y="1075" as="sourcePoint" />
            <mxPoint x="900" y="1075" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== GENERAL NOTE ==================== -->
        <mxCell id="note_gen" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;fontStyle=2;spacingLeft=4;spacingTop=4;" value="Upload requires is_admin (session validated against Keycloak). Ingestion is async (CLAUDE.md §8):&#xa;FastAPI returns 202 immediately; Celery processes independently. Chunking uses BGE-M3's actual tokenizer, not char length.&#xa;Redis is both Celery message broker and result backend. On re-ingestion, overlapping semantic_cache entries are invalidated (§9)." vertex="1">
          <mxGeometry height="60" width="820" x="160" y="1230" as="geometry" />
        </mxCell>

