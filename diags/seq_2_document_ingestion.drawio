        </mxCell>
        <mxCell id="async_g" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=2;align=left;" value="[runs independently after the 202 response — Admin does not wait]" vertex="1">
          <mxGeometry height="18" width="440" x="1090" y="545" as="geometry" />
        </mxCell>

        <mxCell id="b01" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="consume task" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1085" y="585" as="sourcePoint" />
            <mxPoint x="900" y="585" as="targetPoint" />
