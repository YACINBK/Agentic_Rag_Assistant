        <!-- guard 2: admin -->
        <mxCell id="alt_g2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=2;align=left;" value="[is_admin = true]" vertex="1">
          <mxGeometry height="20" width="300" x="350" y="354" as="geometry" />
        </mxCell>

        <!-- INSERT Document -->
        <mxCell id="a01" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="INSERT Document (status = pending, doc_hash)" edge="1">
