        <!-- ==================== NESTED: async ingestion ==================== -->

        <mxCell id="async_frame" parent="1" style="shape=mxgraph.uml.frame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;fontStyle=1;width=60;height=22;" value="async" vertex="1">
