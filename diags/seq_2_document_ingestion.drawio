          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1455" y="940" as="sourcePoint" />
            <mxPoint x="1085" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="opt_note" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;fontStyle=2;spacingLeft=4;spacingTop=2;" value="Precise: only cache entries whose chunk_ids&#xa;overlap changed chunks are deleted (§9)." vertex="1">
          <mxGeometry height="30" width="330" x="1095" y="960" as="geometry" />
        </mxCell>

        <!-- status = done -->
        <mxCell id="b09" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="UPDATE Document (status = done, chunk_count = N)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1085" y="1040" as="sourcePoint" />
            <mxPoint x="715" y="1040" as="targetPoint" />
