        <mxCell id="x_note" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;fontStyle=2;spacingLeft=4;spacingTop=2;" value="Primary role alone never grants upload (CLAUDE.md §12)." vertex="1">
          <mxGeometry height="24" width="380" x="350" y="310" as="geometry" />
        </mxCell>

        <!-- alt divider -->
        <mxCell id="alt_div" parent="1" style="html=1;points=[];strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=12 4;" edge="1">
