        <!-- ==================== Celery / Redis note ==================== -->
        <mxCell id="note1" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;spacingLeft=8;spacingTop=6;spacingRight=8;" value="Ingestion pipeline (CLAUDE.md §8):&#xa;&#xa;• FastAPI publishes task to Redis (broker), returns 202 immediately&#xa;• Celery worker picks up and runs ingest() independently&#xa;• Chunking: 800 tokens, 200 overlap, recursive splitting&#xa;• Token counting uses BGE-M3 actual tokenizer, not character length&#xa;• On re-ingestion: old chunk IDs replaced, semantic cache entries&#xa;  with overlapping chunk_ids are invalidated (§9)" vertex="1">
          <mxGeometry height="130" width="420" x="80" y="370" as="geometry" />
        </mxCell>

