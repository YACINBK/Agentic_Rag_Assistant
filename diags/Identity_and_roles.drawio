        <!-- ==================== Association ==================== -->
        <mxCell id="e1" edge="1" parent="1" source="role_hdr" style="endArrow=none;html=1;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;fontSize=9;" target="user_hdr" value="has">
          <mxGeometry relative="1" as="geometry" />
