        <!-- ==================== User ==================== -->
        <mxCell id="user_hdr" parent="1" style="rectangle;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="User" vertex="1">
          <mxGeometry height="28" width="300" x="500" y="80" as="geometry" />
        </mxCell>
        <mxCell id="user_attr" parent="1" style="rectangle;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="- id : UUID {PK}&#xa;- email : string {unique}&#xa;- keycloak_id : string {unique}&#xa;- role_id : UUID {FK → Role}&#xa;- is_admin : boolean = false&#xa;- is_owner : boolean = false&#xa;- created_at : timestamp&#xa;- last_login : timestamp" vertex="1">
          <mxGeometry height="155" width="300" x="500" y="108" as="geometry" />
