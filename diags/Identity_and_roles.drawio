        <mxCell id="m1a" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;" value="1" vertex="1">
          <mxGeometry height="16" width="20" x="350" y="86" as="geometry" />
        </mxCell>
        <mxCell id="m1b" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;" value="0..*" vertex="1">
          <mxGeometry height="16" width="30" x="460" y="86" as="geometry" />
        </mxCell>

        <!-- ==================== Constraints note ==================== -->
        <mxCell id="note1" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;spacingLeft=8;spacingTop=6;spacingRight=8;" value="Constraints (CLAUDE.md §10, §12):&#xa;&#xa;• UNIQUE INDEX idx_single_owner ON &quot;user&quot; (is_owner) WHERE is_owner = true&#xa;  — enforces at most one Owner at the database level&#xa;&#xa;• is_admin is additive — it never overrides or replaces the primary role&#xa;• is_owner is additive — inherits all Admin capabilities automatically&#xa;• Owner is seeded at deployment, not assignable through the UI&#xa;• Admin assignment (is_admin) requires is_owner — Admin cannot self-promote&#xa;&#xa;• Roles are dynamic (lookup table) — adding a role is an INSERT + Keycloak config&#xa;• No code may hardcode role names — filter by user's role string&#xa;• Role personas are stored in persona_prompt, not in code" vertex="1">
          <mxGeometry height="200" width="500" x="300" y="320" as="geometry" />
        </mxCell>

        <!-- ==================== Seed values note ==================== -->
        <mxCell id="note2" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;spacingLeft=8;spacingTop=6;spacingRight=8;fontStyle=2;" value="Seed roles: developer, qa_engineer&#xa;New roles: INSERT into Role + Keycloak realm config — no migration needed" vertex="1">
          <mxGeometry height="35" width="400" x="80" y="240" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
