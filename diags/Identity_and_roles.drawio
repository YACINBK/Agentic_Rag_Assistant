        <!-- Title -->
        <mxCell id="t1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;" value="Class Diagram A — Identity and Access Model" vertex="1">
          <mxGeometry height="25" width="900" x="100" y="15" as="geometry" />
        </mxCell>

        <!-- ==================== Role ==================== -->
        <mxCell id="role_hdr" parent="1" style="rectangle;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" value="Role" vertex="1">
          <mxGeometry height="28" width="260" x="80" y="80" as="geometry" />
        </mxCell>
        <mxCell id="role_attr" parent="1" style="rectangle;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=6;" value="- id : UUID {PK}&#xa;- name : string {unique}&#xa;- description : text&#xa;- persona_prompt : text&#xa;- created_at : timestamp" vertex="1">
