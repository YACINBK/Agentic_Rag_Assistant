        <!-- ==================== EXTEND — Filter extends Audit log ==================== -->

        <mxCell id="ext_filter" edge="1" parent="1" source="uc_filteraudit" target="uc_auditlog" style="dashed=1;endArrow=open;endFill=0;strokeColor=#000000;fontSize=9;" value="«extend»">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== Note ==================== -->
        <mxCell id="note1" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;fontStyle=2;spacingLeft=4;spacingTop=4;" value="Generalization: Owner inherits all Admin capabilities (view users, change roles, audit log, etc.).&#xa;Admin = any primary role (from Role table) with is_admin = true. Not a separate role.&#xa;Owner = super-admin seeded at deployment. Owner status is not manageable by Admin.&#xa;Admin cannot assign or revoke is_admin — only Owner can." vertex="1">
          <mxGeometry height="55" width="560" x="300" y="800" as="geometry" />
        </mxCell>

      </root>
