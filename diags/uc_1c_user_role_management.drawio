        <mxCell id="actor_owner" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="Owner" vertex="1">
          <mxGeometry height="60" width="30" x="70" y="120" as="geometry" />
        </mxCell>

        <!-- Admin (bottom) -->
        <mxCell id="actor_admin" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="Admin" vertex="1">
          <mxGeometry height="60" width="30" x="70" y="420" as="geometry" />
        </mxCell>

        <!-- ==================== GENERALIZATION arrow (Admin → Owner) ==================== -->

        <mxCell id="gen_admin_owner" edge="1" parent="1" source="actor_admin" target="actor_owner" style="endArrow=block;endFill=0;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ==================== USE CASES — Admin level ==================== -->

        <mxCell id="uc_viewusers" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" value="View user list" vertex="1">
          <mxGeometry height="50" width="200" x="340" y="330" as="geometry" />
        </mxCell>

        <mxCell id="uc_changerole" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" value="Change user primary role" vertex="1">
          <mxGeometry height="55" width="200" x="340" y="410" as="geometry" />
        </mxCell>

        <mxCell id="uc_auditlog" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" value="View full organizational audit log" vertex="1">
          <mxGeometry height="55" width="220" x="340" y="495" as="geometry" />
        </mxCell>

        <mxCell id="uc_filteraudit" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" value="Filter audit log&#xa;by user / date / type" vertex="1">
          <mxGeometry height="55" width="210" x="710" y="495" as="geometry" />
        </mxCell>

        <!-- ==================== USE CASES — Owner level ==================== -->

        <mxCell id="uc_assign_admin" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" value="Assign Admin status to a user" vertex="1">
          <mxGeometry height="55" width="220" x="340" y="90" as="geometry" />
        </mxCell>

        <mxCell id="uc_revoke_admin" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" value="Revoke Admin status from a user" vertex="1">
          <mxGeometry height="55" width="220" x="340" y="170" as="geometry" />
        </mxCell>

        <mxCell id="uc_view_admins" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" value="View all Admin accounts&#xa;and their active status" vertex="1">
          <mxGeometry height="55" width="220" x="340" y="250" as="geometry" />
        </mxCell>

        <mxCell id="uc_admin_history" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" value="View Admin assignment history" vertex="1">
          <mxGeometry height="55" width="220" x="700" y="250" as="geometry" />
        </mxCell>

        <!-- ==================== Shared use case ==================== -->

        <mxCell id="uc_auth" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=10;" value="Authenticate via Keycloak SSO" vertex="1">
