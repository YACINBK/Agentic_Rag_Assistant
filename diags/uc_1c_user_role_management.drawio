        <!-- ==================== INCLUDE relationships → Authenticate ==================== -->

        <mxCell id="inc_assign_auth" edge="1" parent="1" source="uc_assign_admin" target="uc_auth" style="dashed=1;endArrow=open;endFill=0;strokeColor=#000000;fontSize=9;" value="«include»">
          <mxGeometry relative="1" as="geometry" />
