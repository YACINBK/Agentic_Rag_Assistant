<mxfile host="app.diagrams.net">
  <diagram id="seq3_auth" name="Page-1">
    <mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;" value="Sequence Diagram 3 — Session-Based OIDC Authentication (Authorization Code Flow)" vertex="1">
          <mxGeometry height="30" width="1200" x="100" y="10" as="geometry" />
        </mxCell>

        <!-- ==================== LIFELINE HEADERS (pitch = 210) ==================== -->

        <!-- User (Browser) @160 -->
        <mxCell id="lh_user" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="User&#xa;(Browser)" vertex="1">
          <mxGeometry height="60" width="30" x="145" y="55" as="geometry" />
        </mxCell>
        <mxCell id="ll_user" parent="1" style="html=1;points=[];strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=8 4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="120" as="sourcePoint" />
            <mxPoint x="160" y="1200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- FastAPI @370 -->
        <mxCell id="lh_fastapi" parent="1" style="rectangle;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;align=center;" value="FastAPI&#xa;(authlib)" vertex="1">
          <mxGeometry height="35" width="120" x="310" y="75" as="geometry" />
        </mxCell>
        <mxCell id="ll_fastapi" parent="1" style="html=1;points=[];strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=8 4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="120" as="sourcePoint" />
            <mxPoint x="370" y="1200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Keycloak @580 -->
        <mxCell id="lh_keycloak" parent="1" style="rectangle;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=11;align=center;" value="Keycloak" vertex="1">
          <mxGeometry height="35" width="120" x="520" y="75" as="geometry" />
        </mxCell>
        <mxCell id="ll_keycloak" parent="1" style="html=1;points=[];strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=8 4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="120" as="sourcePoint" />
            <mxPoint x="580" y="1200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- PostgreSQL @790 -->
        <mxCell id="lh_pg" parent="1" style="rectangle;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;fontSize=10;align=center;" value="PostgreSQL" vertex="1">
          <mxGeometry height="35" width="120" x="730" y="75" as="geometry" />
        </mxCell>
        <mxCell id="ll_pg" parent="1" style="html=1;points=[];strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=8 4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="120" as="sourcePoint" />
            <mxPoint x="790" y="1200" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== PRE-AUTH FLOW ==================== -->

        <mxCell id="m01" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="GET /login (no session cookie)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="155" as="sourcePoint" />
            <mxPoint x="370" y="155" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m02" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="302 Redirect → Keycloak /auth (state + PKCE code_challenge)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="190" as="sourcePoint" />
            <mxPoint x="160" y="190" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m02_note" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;fontStyle=2;spacingLeft=4;spacingTop=2;" value="FastAPI generates PKCE code_verifier, stores in transient session,&#xa;builds Keycloak authorize URL with state + code_challenge." vertex="1">
          <mxGeometry height="30" width="420" x="380" y="170" as="geometry" />
        </mxCell>

        <mxCell id="m03" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="follow redirect → Keycloak login page" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="230" as="sourcePoint" />
            <mxPoint x="580" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m04" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="present login form" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="265" as="sourcePoint" />
            <mxPoint x="160" y="265" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m05" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="enter credentials" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="305" as="sourcePoint" />
            <mxPoint x="580" y="305" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== ALT FRAGMENT: CREDENTIAL VALIDATION ==================== -->

        <mxCell id="alt_frame" parent="1" style="shape=mxgraph.uml.frame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=11;fontStyle=1;width=50;height=24;" value="alt" vertex="1">
          <mxGeometry height="760" width="730" x="130" y="335" as="geometry" />
        </mxCell>

        <!-- guard 1: valid credentials -->
        <mxCell id="alt_g1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=2;align=left;" value="[valid credentials]" vertex="1">
          <mxGeometry height="20" width="200" x="200" y="341" as="geometry" />
        </mxCell>

        <!-- Keycloak self-call: validate -->
        <mxCell id="v01" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="validate credentials" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="586" y="380" as="sourcePoint" />
            <mxPoint x="640" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v01r" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="640" y="400" as="sourcePoint" />
            <mxPoint x="586" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Keycloak → Browser: redirect with auth code -->
        <mxCell id="v02" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="302 Redirect → /auth/callback?code=xxx&amp;state=yyy" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="435" as="sourcePoint" />
            <mxPoint x="160" y="435" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Browser → FastAPI: callback -->
        <mxCell id="v03" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="GET /auth/callback?code=xxx&amp;state=yyy" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="470" as="sourcePoint" />
            <mxPoint x="370" y="470" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- FastAPI → Keycloak: exchange code for tokens (server-side) -->
        <mxCell id="v04" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="exchange code + code_verifier for tokens (server-to-server)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="510" as="sourcePoint" />
            <mxPoint x="580" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Keycloak → FastAPI: tokens -->
        <mxCell id="v05" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="access_token (JWT) + id_token + refresh_token" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="545" as="sourcePoint" />
            <mxPoint x="370" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- FastAPI self-call: validate + extract claims -->
        <mxCell id="v06" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="validate JWT signature, extract claims (role, email, keycloak_id)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="376" y="580" as="sourcePoint" />
            <mxPoint x="440" y="580" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v06r" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="600" as="sourcePoint" />
            <mxPoint x="376" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== OPT FRAGMENT: LAZY SYNC ===== -->

        <mxCell id="opt_frame" parent="1" style="shape=mxgraph.uml.frame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontSize=10;fontStyle=1;width=50;height=22;" value="opt" vertex="1">
          <mxGeometry height="110" width="500" x="310" y="620" as="geometry" />
        </mxCell>
        <mxCell id="opt_g" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=2;align=left;" value="[first login or claims changed — lazy sync]" vertex="1">
          <mxGeometry height="18" width="300" x="370" y="624" as="geometry" />
        </mxCell>

        <mxCell id="v07" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="UPSERT User (keycloak_id, email, role)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="665" as="sourcePoint" />
            <mxPoint x="790" y="665" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v07r" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="user record" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="790" y="700" as="sourcePoint" />
            <mxPoint x="370" y="700" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- FastAPI creates session + sets cookie -->
        <mxCell id="v08" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="create server-side session (store tokens + claims)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="376" y="755" as="sourcePoint" />
            <mxPoint x="440" y="755" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v08r" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="440" y="775" as="sourcePoint" />
            <mxPoint x="376" y="775" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Set-Cookie + redirect to app -->
        <mxCell id="v09" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="302 Redirect → / (Set-Cookie: session_id, HttpOnly, Secure, SameSite=Lax)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="810" as="sourcePoint" />
            <mxPoint x="160" y="810" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="v09_note" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;fontStyle=2;spacingLeft=4;spacingTop=2;" value="Token never reaches the browser. Only an opaque session_id cookie.&#xa;HttpOnly prevents XSS token theft. CSRF middleware protects state-changing requests." vertex="1">
          <mxGeometry height="30" width="480" x="145" y="820" as="geometry" />
        </mxCell>

        <!-- Subsequent request -->
        <mxCell id="v10" parent="1" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#000000;fontSize=10;" value="GET / (cookie: session_id)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="160" y="875" as="sourcePoint" />
            <mxPoint x="370" y="875" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="v11" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="render dashboard (Jinja2 template, HTMX-powered)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="370" y="910" as="sourcePoint" />
            <mxPoint x="160" y="910" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== ALT DIVIDER ===== -->
        <mxCell id="alt_div" parent="1" style="html=1;points=[];strokeColor=#000000;strokeWidth=1;dashed=1;dashPattern=12 4;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="950" as="sourcePoint" />
            <mxPoint x="860" y="950" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- guard 2: invalid credentials -->
        <mxCell id="alt_g2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=2;align=left;" value="[invalid credentials]" vertex="1">
          <mxGeometry height="20" width="200" x="200" y="954" as="geometry" />
        </mxCell>

        <mxCell id="f01" parent="1" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#000000;fontSize=10;" value="error — invalid credentials (stays on Keycloak login page)" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="580" y="1000" as="sourcePoint" />
            <mxPoint x="160" y="1000" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="f_note" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;fontStyle=2;spacingLeft=4;spacingTop=2;" value="User stays on Keycloak login page.&#xa;No callback, no session created. May retry." vertex="1">
          <mxGeometry height="30" width="260" x="200" y="1015" as="geometry" />
        </mxCell>

        <!-- ==================== GENERAL NOTE ==================== -->
        <mxCell id="note_gen" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;fontStyle=2;spacingLeft=4;spacingTop=4;" value="Session-based OIDC Authorization Code flow with PKCE. FastAPI manages the entire flow via authlib.&#xa;Tokens are stored server-side — browser only receives an opaque HttpOnly session cookie.&#xa;No JWT in browser, no Bearer header. CSRF middleware mandatory on all state-changing endpoints.&#xa;Lazy sync: User record upserted from JWT claims on first login or when claims change — no webhook infrastructure.&#xa;Subsequent requests validated against the server-side session; Keycloak JWKS checked lazily for token refresh." vertex="1">
          <mxGeometry height="75" width="620" x="130" y="1110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
