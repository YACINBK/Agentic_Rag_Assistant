        <!-- ==================== GENERAL NOTE ==================== -->
        <mxCell id="note_gen" parent="1" style="text;html=1;strokeColor=#000000;fillColor=#ffffff;align=left;fontSize=9;fontStyle=2;spacingLeft=4;spacingTop=4;" value="Safety-net paths that protect against irrelevant results and hallucination.&#xa;Relevance gate: pure Python threshold check (no LLM). Retry broadens the query ONCE only.&#xa;Faithfulness: token overlap heuristic MVP (no LLM). Unfaithful answer is DISCARDED, never streamed.&#xa;Both paths write to AuditLog (append-only). Faithfulness failure also creates an EscalationEvent." vertex="1">
